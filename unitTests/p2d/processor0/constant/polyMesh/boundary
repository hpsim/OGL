FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

7
(
    movingWall
    {
        type            wall;
        inGroups        1(wall);
        nFaces          0;
        startFace       10;
    }
    fixedWalls
    {
        type            wall;
        inGroups        1(wall);
        nFaces          6;
        startFace       10;
    }
    side1
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          1;
        startFace       16;
        matchTolerance  0.0001;
        transform       unknown;
        neighbourPatch  side2;
    }
    side2
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          1;
        startFace       17;
        matchTolerance  0.0001;
        transform       unknown;
        neighbourPatch  side1;
    }
    frontAndBack
    {
        type            empty;
        inGroups        1(empty);
        nFaces          18;
        startFace       18;
    }
    procBoundary0to1
    {
        type            processor;
        inGroups        1(processor);
        nFaces          7;
        startFace       36;
        matchTolerance  0.0001;
        transform       unknown;
        myProcNo        0;
        neighbProcNo    1;
    }
    procBoundary0to1throughside2
    {
        type            processorCyclic;
        inGroups        1(processorCyclic);
        nFaces          1;
        startFace       43;
        matchTolerance  0.0001;
        transform       unknown;
        myProcNo        0;
        neighbProcNo    1;
        referPatch      side2;
    }
)

