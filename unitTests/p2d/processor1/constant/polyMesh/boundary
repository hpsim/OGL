FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

7
(
    movingWall
    {
        type            wall;
        inGroups        1(wall);
        nFaces          0;
        startFace       7;
    }
    fixedWalls
    {
        type            wall;
        inGroups        1(wall);
        nFaces          0;
        startFace       7;
    }
    side1
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          1;
        startFace       7;
        matchTolerance  0.0001;
        transform       unknown;
        neighbourPatch  side2;
    }
    side2
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          1;
        startFace       8;
        matchTolerance  0.0001;
        transform       unknown;
        neighbourPatch  side1;
    }
    frontAndBack
    {
        type            empty;
        inGroups        1(empty);
        nFaces          16;
        startFace       9;
    }
    procBoundary1to0
    {
        type            processor;
        inGroups        1(processor);
        nFaces          8;
        startFace       25;
        matchTolerance  0.0001;
        transform       unknown;
        myProcNo        1;
        neighbProcNo    0;
    }
    procBoundary1to2
    {
        type            processor;
        inGroups        1(processor);
        nFaces          8;
        startFace       33;
        matchTolerance  0.0001;
        transform       unknown;
        myProcNo        1;
        neighbProcNo    2;
    }
)

